# .env.example — 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# AWS / Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# 스냅샷 기준일 (오늘=D0, 내일=D+1, 모레=D+2)
TODAY=2026-11-06

# true 면 book_boat 를 자동 승인(평가용). 기본 false = 사람 승인(HITL)
EVAL_AUTO_APPROVE=false

# 트레이싱: 키가 있으면 LangSmith, 없으면 traces/*.jsonl 로컬 기록
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fishing-agent
