# .env.example — 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# AWS / Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# 스냅샷 기준일 (오늘=D0, 내일=D+1, 모레=D+2). WEATHER_SOURCE=csv 일 때만 쓴다
TODAY=2026-11-06

# 날씨 소스: csv(기본, data/forecast.csv 고정 스냅샷·평가용) | kma(기상청 실시간, 오늘~글피)
WEATHER_SOURCE=csv
# 공공데이터포털 인증키. '기상청_단기예보 조회서비스'와 '기상청_기상특보 조회서비스'를 활용신청한다
KMA_SERVICE_KEY=
KMA_TIMEOUT_SEC=5
KMA_CACHE_TTL_SEC=1800
# (선택) 국립해양조사원 바다누리 OpenAPI 키. 있으면 만조·간조 시각을 보여준다. 없으면 물때 이름만 계산한다
KHOA_SERVICE_KEY=

# true 면 book_boat 를 자동 승인(평가용). 기본 false = 사람 승인(HITL)
EVAL_AUTO_APPROVE=false

# 트레이싱: 키가 있으면 LangSmith, 없으면 traces/*.jsonl 로컬 기록
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fishing-agent
